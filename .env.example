# =============================================================================
# Slimming Gym Fitness - Variables de Docker Compose
# =============================================================================
# Copia este archivo como .env en la raiz del proyecto y completa los valores.
#
#   cp .env.example .env
#
# El .env NUNCA se versiona (esta en .gitignore): contiene credenciales.
# Este archivo es distinto de backend-gimnasio/.env, que se usa cuando se
# ejecuta la API directamente con `node server.js` sin contenedores.
# =============================================================================

# --- Base de datos ---
# Contrasena del usuario 'sa' del contenedor de SQL Server. SQL Server exige al
# menos 8 caracteres con mayusculas, minusculas y numeros o simbolos.
MSSQL_SA_PASSWORD=

# Credenciales con las que la API se conecta. En produccion deberia ser un
# usuario de aplicacion con permisos minimos (db_datareader + db_datawriter +
# EXECUTE), nunca 'sa'. Ver database/README_INSTALACION_VM.md
DB_NAME=slimming_gym_db
DB_USER=slimming_app
DB_PASSWORD=

# --- Seguridad (OBLIGATORIAS) ---
# La API no arranca si JWT_SECRET falta o mide menos de 32 caracteres.
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Secreto compartido que valida el webhook de la pasarela de pagos
# (cabecera x-webhook-secret). Sin el, el webhook rechaza toda peticion.
WEBHOOK_SECRET=

# --- Dominio ---
# Con Nginx sirviendo el frontend y la API bajo el mismo dominio, el navegador
# no realiza peticiones de otro origen, asi que CORS practicamente no interviene.
# Se mantiene la lista blanca para clientes externos.
FRONTEND_URL=https://tu-dominio.com
ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# --- Correo electronico (Nodemailer / SMTP) ---
# Para Gmail se requiere una "App Password", no la contrasena de la cuenta.
SMTP_EMAIL=
SMTP_PASSWORD=
