# =============================================================================
# Slimming Gym Fitness - Variables de entorno del Backend
# =============================================================================
# Copia este archivo como .env y completa los valores reales.
# El .env NUNCA se versiona (esta en .gitignore): contiene credenciales.
# =============================================================================

# --- Servidor Node.js ---
PORT=5001
NODE_ENV=development

# --- Base de datos SQL Server ---
# En la VM de produccion la BD corre en la misma maquina: usar localhost y
# NO exponer el puerto 1433 a la red.
DB_SERVER=localhost
DB_PORT=1433
DB_USER=slimming_app
DB_PASSWORD=
DB_NAME=slimming_gym_db
# DB_INSTANCE=SQLEXPRESS   # Solo para instancias nombradas de SQL Server

# --- Seguridad y autenticacion (OBLIGATORIAS) ---
# El servidor NO arranca si JWT_SECRET falta o mide menos de 32 caracteres.
# Genera cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Secreto compartido para validar el webhook de pagos (cabecera x-webhook-secret)
WEBHOOK_SECRET=

# --- CORS y dominio del frontend ---
# Lista separada por comas de los origenes autorizados a consumir la API.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google Cloud Storage (comprobantes de pago) ---
# El archivo de credenciales NO se versiona. Colocalo fuera del repo en la VM
# y apunta GCS_KEYFILE_PATH a su ruta absoluta.
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_KEYFILE_PATH=./config/google-key.json

# --- Correo electronico (Nodemailer / SMTP) ---
# Para Gmail se requiere una "App Password", no la contrasena de la cuenta.
SMTP_EMAIL=
SMTP_PASSWORD=
# Por defecto se usa el servicio 'gmail'. Para apuntar a otro servidor SMTP,
# define SMTP_HOST y el resto de estas variables tomara efecto:
# SMTP_HOST=smtp.midominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
